# Database
# Local Postgres (docker-compose):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/backtesting

# Supabase (use the "Session pooler" or "Transaction pooler" connection string
# from Project Settings -> Database -> Connection string -> URI, then change
# the prefix from postgresql:// to postgresql+psycopg2://):
# DATABASE_URL=postgresql+psycopg2://postgres.xxxxxxxx:[email protected]:6543/postgres

ENV=development
DEBUG=true

# CORS
# Only needed if your frontend runs somewhere other than localhost:3000.
# Must be a JSON array string:
# CORS_ORIGINS=["http://localhost:3000","https://your-deployed-frontend.com"]
